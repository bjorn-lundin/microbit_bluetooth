with "config/microbit_v2_demo_config.gpr";
with "runtime_build.gpr";
with "ravenscar_build.gpr";

project Microbit_V2_Demo is

   --  Target och runtime kommer från light_tasking_nrf52833.
   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Microbit_V2_Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("microbit_v2_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Microbit_V2_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--gc-sections");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Microbit_V2_Demo;
