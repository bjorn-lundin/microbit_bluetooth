--  5x5-font för micro:bit, ASCII 32 .. 126.
--
--  Glyferna är hämtade från fonten "pendolino3" i CODAL
--  (https://github.com/lancaster-university/codal-core,
--  source/types/BitmapFont.cpp):
--
--    The MIT License (MIT)
--    Copyright (c) 2017 Lancaster University.
--
--  Varje rad är ett tal där bit 4 är kolumn 0 (längst till vänster) och
--  bit 0 är kolumn 4.

package Microbit_V2.Font with Pure is

   subtype Glyph_Character is Character range ' ' .. '~';

   type Row_Bits is mod 2**5;
   type Glyph is array (0 .. 4) of Row_Bits;

   function Pixel (G : Glyph; X, Y : Natural) return Boolean is
     ((G (Y) and 2**(4 - X)) /= 0)
   with Pre => X <= 4 and then Y <= 4;

   Glyphs : constant array (Glyph_Character) of Glyph :=
     (
      ' ' => (2#00000#, 2#00000#, 2#00000#, 2#00000#, 2#00000#),
      '!' => (2#01000#, 2#01000#, 2#01000#, 2#00000#, 2#01000#),
